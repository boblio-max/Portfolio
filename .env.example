# Copy to .env (never commit .env). All values are server-side only.
# GitHub username that owns most tracked repos (see server/config.js).
GITHUB_USERNAME=boblio-max
# Personal access token (classic or fine-grained, public-repo read is enough).
# Raises API quota from 60/hr to 5,000/hr. Required for syncing ~45 repos.
GITHUB_TOKEN=
# Local port for `node server/server.js`.
PORT=3000
